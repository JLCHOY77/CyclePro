// CyclingPRO - Prisma Schema optimizado para Supabase
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ADMIN
}

enum BookingStatus {
  PENDING
  IN_WORKSHOP
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  YAPPY
  CARD
  CASH
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Usuario vinculado al UUID de Supabase Auth
model User {
  id            String      @id @default(uuid())
  email         String      @unique
  name          String?
  phone         String?
  role          UserRole    @default(CLIENT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  bicycles      Bicycle[]
  bookings      Booking[]
  
  @@map("users")
}

// Bicicletas de los clientes
model Bicycle {
  id            String      @id @default(uuid())
  userId        String
  brand         String
  model         String
  serialNumber  String?     @unique
  color         String?
  purchaseDate  DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  
  @@map("bicycles")
}

// Catálogo de servicios de mantenimiento
model Service {
  id            String      @id @default(uuid())
  name          String
  description   String?
  price         Float
  duration      Int         // Duración en minutos
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  bookings      Booking[]
  
  @@map("services")
}

// Citas de servicio
model Booking {
  id              String          @id @default(uuid())
  userId          String
  bicycleId       String
  serviceId       String
  date            DateTime
  status          BookingStatus   @default(PENDING)
  notes           String?
  googleEventId   String?         // ID del evento en Google Calendar
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bicycle         Bicycle         @relation(fields: [bicycleId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  transaction     Transaction?
  
  @@map("bookings")
}

// Log de transacciones de pago
model Transaction {
  id                  String              @id @default(uuid())
  bookingId           String              @unique
  amount              Float
  method              PaymentMethod
  status              TransactionStatus   @default(PENDING)
  pagueloFacilRef     String?             // Referencia de Paguelo Facil
  yappiPhone          String?             // Teléfono de Yappy si aplica
  transactionDate     DateTime            @default(now())
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  
  booking             Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  @@map("transactions")
}